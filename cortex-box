#!/usr/bin/env bash
# cortex im Container starten -- isoliert vom System, mit vollem Netz.
#
#   ./cortex-box --setup           einmalige Einrichtung (schreibt ./.env)
#   ./cortex-box                   Chat
#   ./cortex-box "deine Frage"     einmalige Recherche
#   ./cortex-box search "test"     nur die Suche, ohne LLM
#   ./cortex-box --build           Image neu bauen, dann starten
#   ./cortex-box --lan ...         mit der Netzwerkkarte des Rechners, damit
#                                  cortex Heimnetz und Home Assistant sieht
set -euo pipefail

cd "$(dirname "$0")"
mkdir -p exports

# Unter Linux laeuft der Container unter der eigenen UID, damit Exporte
# nicht root gehoeren. Docker Desktop (macOS/Windows) regelt das selbst.
if [[ "$(uname -s)" == "Linux" ]]; then
    CORTEX_UID="$(id -u)"
    CORTEX_GID="$(id -g)"
    export CORTEX_UID CORTEX_GID
fi

# Ohne die Netzwerkkarte des Rechners haengt der Container in Dockers
# eigenem Bruecken-Netz -- von dort ist das Heimnetz nicht zu sehen, und
# `cortex lan` wie `connect-ha` faenden nichts.
if [[ "${1:-}" == "--lan" ]]; then
    shift
    export CORTEX_NETWORK=host
fi

case "${1:-}" in
    --build)
        shift
        docker compose build cortex
        ;;
    --setup)
        # Der Container darf nur nach /work schreiben; von dort holen wir
        # die fertige .env ins Projektverzeichnis.
        docker compose run --rm cortex setup --env-file /work/.env
        if [[ -f exports/.env ]]; then
            mv exports/.env .env
            echo "Konfiguration gespeichert in $(pwd)/.env"
        fi
        exit 0
        ;;
esac

if [[ ! -f .env ]]; then
    echo "Keine .env gefunden -- richte cortex einmalig ein:" >&2
    echo "  ./cortex-box --setup" >&2
    exit 1
fi

exec docker compose run --rm cortex "$@"
