#!/usr/bin/env bash
# scoutr im Container starten -- isoliert vom System, mit vollem Netz.
#
#   ./scoutr-box --setup           einmalige Einrichtung (schreibt ./.env)
#   ./scoutr-box                   Chat
#   ./scoutr-box "deine Frage"     einmalige Recherche
#   ./scoutr-box search "test"     nur die Suche, ohne LLM
#   ./scoutr-box --build           Image neu bauen, dann starten
set -euo pipefail

cd "$(dirname "$0")"
mkdir -p exports

# Unter Linux laeuft der Container unter der eigenen UID, damit Exporte
# nicht root gehoeren. Docker Desktop (macOS/Windows) regelt das selbst.
if [[ "$(uname -s)" == "Linux" ]]; then
    SCOUTR_UID="$(id -u)"
    SCOUTR_GID="$(id -g)"
    export SCOUTR_UID SCOUTR_GID
fi

case "${1:-}" in
    --build)
        shift
        docker compose build scoutr
        ;;
    --setup)
        # Der Container darf nur nach /work schreiben; von dort holen wir
        # die fertige .env ins Projektverzeichnis.
        docker compose run --rm scoutr setup --env-file /work/.env
        if [[ -f exports/.env ]]; then
            mv exports/.env .env
            echo "Konfiguration gespeichert in $(pwd)/.env"
        fi
        exit 0
        ;;
esac

if [[ ! -f .env ]]; then
    echo "Keine .env gefunden -- richte scoutr einmalig ein:" >&2
    echo "  ./scoutr-box --setup" >&2
    exit 1
fi

exec docker compose run --rm scoutr "$@"
