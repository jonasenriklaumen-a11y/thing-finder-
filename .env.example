# ---------------------------------------------------------------------------
# aquaticy configuration -- kopiere diese Datei nach .env (oder nutze `aquaticy setup`)
# ---------------------------------------------------------------------------

# LLM-Modell im LiteLLM-Format. Das Modell MUSS Tool-Calling beherrschen,
# sonst kann der Agent weder suchen noch Seiten lesen. Aquaticy ist auf zwei
# Anbieter eingerichtet -- fuer die weiss er, welches Modell wofuer taugt:
#   mistral/mistral-large-latest               (Key: MISTRAL_API_KEY)
#   nvidia_nim/meta/llama-3.3-70b-instruct     (Key: NVIDIA_NIM_API_KEY)
#   ollama_chat/qwen2.5:7b                     (lokal, kein Key -- siehe unten)
#
# Fuer ein lokales Modell richtet `aquaticy install-model` alles selbst ein.
# Wichtig: das Praefix heisst ollama_chat, nicht ollama -- nur ersteres
# beherrscht Tool-Calling.
AQUATICY_MODEL=mistral/mistral-large-latest

# Vision-Modell fuer `--image` / `/image`. Leer = AQUATICY_MODEL benutzen.
AQUATICY_VISION_MODEL=

# API-Key des LLM-Anbieters
MISTRAL_API_KEY=
# NVIDIA_NIM_API_KEY=            # https://build.nvidia.com/

# Notausgang fuer Anbieter, die aquaticy nicht namentlich kennt: LiteLLM kann
# weit mehr, als hier aufgezaehlt ist. Ist AQUATICY_API_KEY gesetzt, wird der
# Wert fuer jeden nicht gelisteten Anbieter benutzt. Die Modellrollen und
# Anfragegrenzen unten gelten dann nicht -- Aquaticy kennt sie fuer ein
# fremdes Modell ja nicht.
# AQUATICY_API_KEY=

# Wie schnell gefragt werden darf. Voreingestellt ist, was der Anbieter im
# Freikontingent vertraegt: NVIDIA 40 Anfragen/Minute bei 4 gleichzeitigen,
# Mistral 240 bei 8. Aquaticy haelt das selbst ein, statt in 429er zu laufen
# und jede abgelehnte Anfrage zu wiederholen. Wer einen groesseren Vertrag
# hat, hebt es hier an -- die Werte gelten dann fuer alle Anbieter.
# AQUATICY_RPM=600
# AQUATICY_PARALLEL_CALLS=32

# Suchanfragen: Wie viele Formulierungen derselben Frage rausgehen. Eine
# einzige findet nur, was zufaellig genau so im Netz steht; zwei bis drei
# decken deutlich mehr ab. Ab der vierten wird es beliebig. 1 = aus.
AQUATICY_SEARCH_VARIANTS=3

# Lagerverwaltung im eigenen Netz (storage-system): Raum > Moebel > Artikel.
# Leer = nicht angebunden. ACCESS steuert, was Aquaticy dort darf:
#   off    gar nichts -- die Werkzeuge gibt es fuer das Modell nicht
#   read   suchen und nachsehen (Default)
#   write  zusaetzlich anlegen und aendern
# Geloescht wird in keiner Stufe. Und: der Server selbst hat keine Anmeldung,
# "read" ist also eine Fessel fuer Aquaticy, kein Schloss am Server.
# AQUATICY_STORAGE_URL=192.168.1.5:3000
AQUATICY_STORAGE_ACCESS=read

# Gmail und Google Kalender -- nur lesend, und aus, bis du es einschaltest.
# Einrichtung siehe README, Abschnitt "Gmail und Google Kalender".
AQUATICY_GOOGLE=false
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Optionale eigene Basis-URL (Ollama, LiteLLM-Proxy, eigene NIM, Azure ...)
# Achtung beim Anbieterwechsel: Eine Adresse auf dem Ollama-Port (11434) passt
# nur zu einem lokalen Modell. Zeigt AQUATICY_MODEL woandershin, laesst aquaticy sie
# weg -- sonst antwortet Ollama mit "404 page not found". Jede andere Adresse
# (Proxy, eigenes NIM) bleibt stehen.
# AQUATICY_API_BASE=http://localhost:11434

# Suchmaschine.
#   duckduckgo  offene Metasuche ueber mehrere Engines -- KEIN API-Key (Default)
#   searxng     eigene oder fremde SearXNG-Instanz    -- KEIN API-Key
#   brave       kommerzielle API                      -- BRAVE_API_KEY
#   tavily      kommerzielle API                      -- TAVILY_API_KEY
AQUATICY_SEARCH_BACKEND=duckduckgo

# Nur fuer die offene Metasuche: Engines einschraenken (leer = alle).
# Verfuegbar: duckduckgo, mojeek, startpage, brave, yahoo, wikipedia
# AQUATICY_SEARCH_ENGINES=duckduckgo,mojeek

# Nur fuer searxng: Adresse der Instanz. Eigene starten mit
#   docker run -d -p 8080:8080 searxng/searxng
# In der settings.yml muss unter `search.formats` der Eintrag `json` stehen.
# AQUATICY_SEARXNG_URL=http://localhost:8080

# Nur fuer die kommerziellen Backends:
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Standard-Ortsfilter (kann per --location / /location ueberschrieben werden)
AQUATICY_LOCATION=
AQUATICY_LANG=de
AQUATICY_COUNTRY=de

# Limits
AQUATICY_MAX_TOOL_CALLS=20

# Subagenten: aquaticy zerlegt jede Anfrage in Teilfragen und recherchiert sie
# parallel. SUBAGENTS_AUTO=false laesst nur noch das Modell selbst entscheiden,
# MAX_SUBAGENTS=0 schaltet alles ab.
AQUATICY_SUBAGENTS_AUTO=true
# Vor der Planung prueft aquaticy kurz, ob die Nachricht ueberhaupt Recherche
# braucht ("hallo" -> nein). Zeitlimit der Pruefung in Sekunden.
AQUATICY_TRIAGE_TIMEOUT=5
# Zeitlimit fuer Vorpruefung und Planung zusammen (ein Aufruf).
AQUATICY_PLANNER_TIMEOUT=20

# Kontextfenster fuer lokale Ollama-Modelle. OHNE das nimmt Ollama 2048-4096
# Token und wirft bei Ueberlauf still den Anfang des Gespraechs weg -- das
# Modell "vergisst" dann die letzte Frage. Mehr kostet VRAM. 0 = Ollama-Default.
AQUATICY_CONTEXT_TOKENS=16384
AQUATICY_MAX_SUBAGENTS=12
AQUATICY_SUBAGENT_BUDGET=6
# Gleichzeitige Subagenten. 0 = automatisch: lokal 2 (die GPU rechnet ohnehin
# nacheinander), in der Cloud alle -- dort ist Warten reine Netzwerklatenz.
AQUATICY_SUBAGENT_PARALLEL=0

# Leichtes Modell fuer die Teilfragen. Leer = das schnelle kleine Modell des
# Anbieters (mistral-small, llama-3.1-8b); kennt Aquaticy zum Anbieter keins,
# bleibt es beim Hauptmodell.
# AQUATICY_SUBAGENT_MODEL=ollama_chat/qwen3:1.7b

# Stabilitaet: Wiederholungen und Kontextgroesse. Die Vorgaben sind auf kleine
# lokale Modelle ausgelegt -- bei Cloud-Modellen darf MAX_TOOL_CHARS groesser sein.
AQUATICY_LLM_RETRIES=3
AQUATICY_MAX_TOOL_CHARS=8000
AQUATICY_KEEP_FULL_RESULTS=4
AQUATICY_FETCH_TIMEOUT=15
AQUATICY_CACHE_TTL_HOURS=24

# Playwright-Fallback fuer JS-only-Seiten (benoetigt `aquaticy install-browser`)
AQUATICY_ENABLE_PLAYWRIGHT=true

# Die Werkstatt: die abgeschottete Maschine fuer den Code-Modus. Zwei
# Groessen -- normal reicht fuer die meisten Aufgaben, plus fuer alles, was
# mehr Rechenleistung braucht (z.B. Blender rendern, siehe README).
#   normal   1 Kern, 1 GB Arbeitsspeicher, 4 GB Speicher (Default)
#   plus     4 Kerne, 6 GB Arbeitsspeicher, 20 GB Speicher
AQUATICY_VM_SIZE=normal
# Eigenes Abbild statt python:3.12-slim, z.B. eins mit Blender:
#   docker build -f docker/workshop-blender.Dockerfile -t aquaticy-workshop-blender:local .
# AQUATICY_VM_IMAGE=aquaticy-workshop-blender:local
# Wer die Groesse nicht ueber AQUATICY_VM_SIZE, sondern einzeln setzen will:
# AQUATICY_VM_CPUS=1
# AQUATICY_VM_MEMORY_MB=1024
# AQUATICY_VM_DISK_GB=4
# AQUATICY_VM_IDLE_MINUTES=20

# Optional: Amazon Product Advertising API (ohne Key wird Amazon nur verlinkt)
# AMAZON_PAAPI_KEY=
# AMAZON_PAAPI_SECRET=
# AMAZON_PARTNER_TAG=

# ---------------------------------------------------------------------------
# Zuhause: Heimnetz und Home Assistant
# ---------------------------------------------------------------------------
# Darf aquaticy ins eigene Netz sehen? Nur private Bereiche (10.x, 172.16-31.x,
# 192.168.x, Tailnet), nur die Frage ob etwas antwortet -- keine Passwort-
# versuche, keine Schwachstellensuche.
AQUATICY_LAN_ENABLED=true
# Leer = eigenes Netz automatisch erkennen.
# AQUATICY_LAN_SUBNET=192.168.1.0/24

# Home Assistant. Beides richtet `aquaticy connect-ha` in einer Minute ein.
# AQUATICY_HA_URL=http://192.168.1.5:8123
# HA_TOKEN=

# Darf aquaticy auch SCHALTEN, oder nur nachsehen? Aus gutem Grund standardmaessig
# aus. Auch mit true fragt er bei Schloessern, Alarmanlagen, Toren, Rollaeden,
# Heizung und Saugrobotern jedes Mal nach.
AQUATICY_HA_CONTROL=false

# ---------------------------------------------------------------------------
# Langzeitspeicher
# ---------------------------------------------------------------------------
# Darf Aquaticy AI sich ueber Gespraeche hinweg Dinge merken? Nur Text, nie
# Bilder. Alles liegt verschluesselt in der Datenbank, hoechstens 400 MB
# zusammen mit Verlauf und hochgeladenen Dateien.
AQUATICY_MEMORY=true

# Ohne Angabe liegt der Schluessel als Datei neben der Datenbank, lesbar nur
# fuer dich. Das schuetzt Backups und kopierte Datentraeger. Wer auch gegen
# jemanden schuetzen will, der schon im Benutzerkonto sitzt, traegt hier eine
# Passphrase ein -- dann liegt gar kein Schluessel auf der Platte. Achtung:
# vergessene Passphrase heisst verlorener Speicher.
# AQUATICY_MEMORY_KEY=
