# ---------------------------------------------------------------------------
# scoutr configuration -- kopiere diese Datei nach .env (oder nutze `scoutr setup`)
# ---------------------------------------------------------------------------

# LLM-Modell im LiteLLM-Format. Beispiele:
#   anthropic/claude-sonnet-4-6      (Key: ANTHROPIC_API_KEY)
#   openai/gpt-4o                    (Key: OPENAI_API_KEY)
#   ollama/llama3.1                  (kein Key, SCOUTR_API_BASE=http://localhost:11434)
SCOUTR_MODEL=anthropic/claude-sonnet-4-6

# Vision-Modell fuer `--image` / `/image`. Leer = SCOUTR_MODEL benutzen.
SCOUTR_VISION_MODEL=

# API-Key des LLM-Anbieters
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optionale eigene Basis-URL (Ollama, LiteLLM-Proxy, Azure ...)
# SCOUTR_API_BASE=http://localhost:11434

# Suchmaschine.
#   duckduckgo  offene Metasuche ueber mehrere Engines -- KEIN API-Key (Default)
#   searxng     eigene oder fremde SearXNG-Instanz    -- KEIN API-Key
#   brave       kommerzielle API                      -- BRAVE_API_KEY
#   tavily      kommerzielle API                      -- TAVILY_API_KEY
SCOUTR_SEARCH_BACKEND=duckduckgo

# Nur fuer die offene Metasuche: Engines einschraenken (leer = alle).
# Verfuegbar: duckduckgo, mojeek, startpage, brave, yahoo, wikipedia
# SCOUTR_SEARCH_ENGINES=duckduckgo,mojeek

# Nur fuer searxng: Adresse der Instanz. Eigene starten mit
#   docker run -d -p 8080:8080 searxng/searxng
# In der settings.yml muss unter `search.formats` der Eintrag `json` stehen.
# SCOUTR_SEARXNG_URL=http://localhost:8080

# Nur fuer die kommerziellen Backends:
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Standard-Ortsfilter (kann per --location / /location ueberschrieben werden)
SCOUTR_LOCATION=
SCOUTR_LANG=de
SCOUTR_COUNTRY=de

# Limits
SCOUTR_MAX_TOOL_CALLS=20
SCOUTR_FETCH_TIMEOUT=15
SCOUTR_CACHE_TTL_HOURS=24

# Playwright-Fallback fuer JS-only-Seiten (benoetigt `scoutr install-browser`)
SCOUTR_ENABLE_PLAYWRIGHT=true

# Optional: Amazon Product Advertising API (ohne Key wird Amazon nur verlinkt)
# AMAZON_PAAPI_KEY=
# AMAZON_PAAPI_SECRET=
# AMAZON_PARTNER_TAG=
