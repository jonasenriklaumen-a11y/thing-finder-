# ---------------------------------------------------------------------------
# scoutr configuration -- kopiere diese Datei nach .env (oder nutze `scoutr setup`)
# ---------------------------------------------------------------------------

# LLM-Modell im LiteLLM-Format. Das Modell MUSS Tool-Calling beherrschen,
# sonst kann der Agent weder suchen noch Seiten lesen. Beispiele:
#   anthropic/claude-sonnet-4-6                (Key: ANTHROPIC_API_KEY)
#   openai/gpt-4o                              (Key: OPENAI_API_KEY)
#   nvidia_nim/meta/llama-3.3-70b-instruct     (Key: NVIDIA_NIM_API_KEY)
#   ollama_chat/qwen2.5:7b                     (lokal, kein Key -- siehe unten)
#
# Fuer ein lokales Modell richtet `scoutr install-model` alles selbst ein.
# Wichtig: das Praefix heisst ollama_chat, nicht ollama -- nur ersteres
# beherrscht Tool-Calling.
SCOUTR_MODEL=anthropic/claude-sonnet-4-6

# Vision-Modell fuer `--image` / `/image`. Leer = SCOUTR_MODEL benutzen.
SCOUTR_VISION_MODEL=

# API-Key des LLM-Anbieters
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NVIDIA_NIM_API_KEY=            # https://build.nvidia.com/
# XAI_API_KEY=
# TOGETHER_API_KEY=

# Notausgang fuer Anbieter, die scoutr nicht namentlich kennt: LiteLLM kann
# weit mehr, als hier aufgezaehlt ist. Ist SCOUTR_API_KEY gesetzt, wird der
# Wert fuer jeden nicht gelisteten Anbieter benutzt.
# SCOUTR_API_KEY=

# Optionale eigene Basis-URL (Ollama, LiteLLM-Proxy, eigene NIM, Azure ...)
# SCOUTR_API_BASE=http://localhost:11434

# Suchmaschine.
#   duckduckgo  offene Metasuche ueber mehrere Engines -- KEIN API-Key (Default)
#   searxng     eigene oder fremde SearXNG-Instanz    -- KEIN API-Key
#   brave       kommerzielle API                      -- BRAVE_API_KEY
#   tavily      kommerzielle API                      -- TAVILY_API_KEY
SCOUTR_SEARCH_BACKEND=duckduckgo

# Nur fuer die offene Metasuche: Engines einschraenken (leer = alle).
# Verfuegbar: duckduckgo, mojeek, startpage, brave, yahoo, wikipedia
# SCOUTR_SEARCH_ENGINES=duckduckgo,mojeek

# Nur fuer searxng: Adresse der Instanz. Eigene starten mit
#   docker run -d -p 8080:8080 searxng/searxng
# In der settings.yml muss unter `search.formats` der Eintrag `json` stehen.
# SCOUTR_SEARXNG_URL=http://localhost:8080

# Nur fuer die kommerziellen Backends:
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Standard-Ortsfilter (kann per --location / /location ueberschrieben werden)
SCOUTR_LOCATION=
SCOUTR_LANG=de
SCOUTR_COUNTRY=de

# Limits
SCOUTR_MAX_TOOL_CALLS=20

# Subagenten: scoutr zerlegt jede Anfrage in Teilfragen und recherchiert sie
# parallel. SUBAGENTS_AUTO=false laesst nur noch das Modell selbst entscheiden,
# MAX_SUBAGENTS=0 schaltet alles ab.
SCOUTR_SUBAGENTS_AUTO=true
# Vor der Planung prueft scoutr kurz, ob die Nachricht ueberhaupt Recherche
# braucht ("hallo" -> nein). Zeitlimit der Pruefung in Sekunden.
SCOUTR_TRIAGE_TIMEOUT=5
# Zeitlimit fuer Vorpruefung und Planung zusammen (ein Aufruf).
SCOUTR_PLANNER_TIMEOUT=20

# Kontextfenster fuer lokale Ollama-Modelle. OHNE das nimmt Ollama 2048-4096
# Token und wirft bei Ueberlauf still den Anfang des Gespraechs weg -- das
# Modell "vergisst" dann die letzte Frage. Mehr kostet VRAM. 0 = Ollama-Default.
SCOUTR_CONTEXT_TOKENS=16384
SCOUTR_MAX_SUBAGENTS=4
SCOUTR_SUBAGENT_BUDGET=6
# Gleichzeitige Subagenten. 0 = automatisch (lokal 2, Cloud 4).
SCOUTR_SUBAGENT_PARALLEL=0

# Leichtes Modell fuer die Teilfragen. Leer = Hauptmodell.
# SCOUTR_SUBAGENT_MODEL=ollama_chat/qwen3:1.7b

# Stabilitaet: Wiederholungen und Kontextgroesse. Die Vorgaben sind auf kleine
# lokale Modelle ausgelegt -- bei Cloud-Modellen darf MAX_TOOL_CHARS groesser sein.
SCOUTR_LLM_RETRIES=3
SCOUTR_MAX_TOOL_CHARS=8000
SCOUTR_KEEP_FULL_RESULTS=4
SCOUTR_FETCH_TIMEOUT=15
SCOUTR_CACHE_TTL_HOURS=24

# Playwright-Fallback fuer JS-only-Seiten (benoetigt `scoutr install-browser`)
SCOUTR_ENABLE_PLAYWRIGHT=true

# Optional: Amazon Product Advertising API (ohne Key wird Amazon nur verlinkt)
# AMAZON_PAAPI_KEY=
# AMAZON_PAAPI_SECRET=
# AMAZON_PARTNER_TAG=

# ---------------------------------------------------------------------------
# Zuhause: Heimnetz und Home Assistant
# ---------------------------------------------------------------------------
# Darf scoutr ins eigene Netz sehen? Nur private Bereiche (10.x, 172.16-31.x,
# 192.168.x, Tailnet), nur die Frage ob etwas antwortet -- keine Passwort-
# versuche, keine Schwachstellensuche.
SCOUTR_LAN_ENABLED=true
# Leer = eigenes Netz automatisch erkennen.
# SCOUTR_LAN_SUBNET=192.168.1.0/24

# Home Assistant. Beides richtet `scoutr connect-ha` in einer Minute ein.
# SCOUTR_HA_URL=http://192.168.1.5:8123
# HA_TOKEN=

# Darf scoutr auch SCHALTEN, oder nur nachsehen? Aus gutem Grund standardmaessig
# aus. Auch mit true fragt er bei Schloessern, Alarmanlagen, Toren, Rollaeden,
# Heizung und Saugrobotern jedes Mal nach.
SCOUTR_HA_CONTROL=false

# ---------------------------------------------------------------------------
# Langzeitspeicher
# ---------------------------------------------------------------------------
# Darf Cortex AI sich ueber Gespraeche hinweg Dinge merken? Nur Text, nie
# Bilder. Alles liegt verschluesselt in der Datenbank, hoechstens 400 MB
# zusammen mit Verlauf und hochgeladenen Dateien.
SCOUTR_MEMORY=true

# Ohne Angabe liegt der Schluessel als Datei neben der Datenbank, lesbar nur
# fuer dich. Das schuetzt Backups und kopierte Datentraeger. Wer auch gegen
# jemanden schuetzen will, der schon im Benutzerkonto sitzt, traegt hier eine
# Passphrase ein -- dann liegt gar kein Schluessel auf der Platte. Achtung:
# vergessene Passphrase heisst verlorener Speicher.
# SCOUTR_MEMORY_KEY=
